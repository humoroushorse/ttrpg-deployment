.PHONY: help check-prereqs create-cluster destroy-cluster list-clusters \
	vault-init vault-unseal vault-configure vault-rotate-db vault-backup vault-restore \
	deploy-local deploy-dev deploy-prod deploy deploy-app deploy-ephemeral \
	verify verify-migrations migration-status migration-logs migration-retry \
	skaffold-dev skaffold-debug skaffold-app skaffold-delete \
	destroy clean \
	teardown build-images deploy-infra init-vault configure-vault deploy-apps deploy-clean

# Default environment
ENV ?= local
VERSION ?= latest
APP ?=
BACKUP ?=

# Cluster configuration
CLUSTER_NAME ?= ttrpg-$(ENV)
REGISTRY_NAME ?= k3d-registry.localhost
REGISTRY_PORT ?= 5000
REGISTRY_HOST ?= localhost:$(REGISTRY_PORT)

# Helm configuration
CHART_PATH := charts/ttrpg-umbrella
RELEASE_NAME := ttrpg-$(ENV)
NAMESPACE := ttrpg-$(ENV)

# Colors for output
COLOR_RESET := \033[0m
COLOR_BOLD := \033[1m
COLOR_GREEN := \033[32m
COLOR_YELLOW := \033[33m
COLOR_BLUE := \033[34m
COLOR_RED := \033[31m

# Helper function to print colored messages
define print_message
	echo "$(COLOR_BOLD)$(COLOR_BLUE)==> $(1)$(COLOR_RESET)"
endef

define print_success
	echo "$(COLOR_BOLD)$(COLOR_GREEN)✓ $(1)$(COLOR_RESET)"
endef

define print_warning
	echo "$(COLOR_BOLD)$(COLOR_YELLOW)⚠ $(1)$(COLOR_RESET)"
endef

define print_error
	echo "$(COLOR_BOLD)$(COLOR_RED)✗ $(1)$(COLOR_RESET)"
endef

##@ General

help: ## Display this help message
	@awk 'BEGIN {FS = ":.*##"; printf "\n$(COLOR_BOLD)Usage:$(COLOR_RESET)\n  make $(COLOR_BLUE)<target>$(COLOR_RESET)\n"} /^[a-zA-Z_0-9-]+:.*?##/ { printf "  $(COLOR_BLUE)%-25s$(COLOR_RESET) %s\n", $$1, $$2 } /^##@/ { printf "\n$(COLOR_BOLD)%s$(COLOR_RESET)\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

check-prereqs: ## Check if required tools are installed
	@$(call print_message,Checking prerequisites...)
	@command -v kubectl >/dev/null 2>&1 || { $(call print_error,kubectl is not installed); exit 1; }
	@command -v helm >/dev/null 2>&1 || { $(call print_error,helm is not installed); exit 1; }
	@command -v vault >/dev/null 2>&1 || { $(call print_error,vault CLI is not installed); exit 1; }
	@command -v k3d >/dev/null 2>&1 || { $(call print_error,k3d is not installed); exit 1; }
	@command -v skaffold >/dev/null 2>&1 || { $(call print_error,skaffold is not installed); exit 1; }
	@$(call print_success,All prerequisites are installed)

##@ Cluster Management

create-cluster: check-prereqs ## Create k3d cluster with registry (ENV=local)
	$(call print_message,Creating k3d cluster: $(CLUSTER_NAME))
	@if k3d cluster list | grep -q $(CLUSTER_NAME); then \
		$(call print_warning,Cluster $(CLUSTER_NAME) already exists); \
	else \
		k3d registry create $(REGISTRY_NAME) --port $(REGISTRY_PORT) || true; \
		k3d cluster create $(CLUSTER_NAME) \
			--registry-use k3d-$(REGISTRY_NAME):$(REGISTRY_PORT) \
			--api-port 6550 \
			--port "8080:80@loadbalancer" \
			--port "8443:443@loadbalancer" \
			--k3s-arg "--disable=traefik@server:*" \
			--agents 2 \
			--wait; \
		$(call print_success,Cluster $(CLUSTER_NAME) created successfully); \
	fi
	@kubectl cluster-info

destroy-cluster: ## Destroy k3d cluster (ENV=local)
	$(call print_message,Destroying k3d cluster: $(CLUSTER_NAME))
	@k3d cluster delete $(CLUSTER_NAME) || $(call print_warning,Cluster $(CLUSTER_NAME) not found)
	$(call print_success,Cluster destroyed)

list-clusters: ## List all k3d clusters
	$(call print_message,Listing k3d clusters...)
	@k3d cluster list

##@ Clean Deployment Automation

teardown: check-prereqs ## Teardown and recreate cluster (ENV=local)
	$(call print_message,Tearing down cluster: $(CLUSTER_NAME))
	@k3d cluster delete $(CLUSTER_NAME) || $(call print_warning,Cluster $(CLUSTER_NAME) not found)
	$(call print_success,Cluster deleted)
	@echo ""
	$(call print_message,Creating fresh cluster: $(CLUSTER_NAME))
	@k3d registry create $(REGISTRY_NAME) --port $(REGISTRY_PORT) || $(call print_warning,Registry already exists)
	@k3d cluster create $(CLUSTER_NAME) \
		--registry-use k3d-$(REGISTRY_NAME):$(REGISTRY_PORT) \
		--api-port 6550 \
		--port "8080:80@loadbalancer" \
		--port "8443:443@loadbalancer" \
		--port "8200:8200@loadbalancer" \
		--k3s-arg "--disable=traefik@server:*" \
		--agents 2 \
		--wait
	$(call print_success,Fresh cluster created)

build-images: check-prereqs ## Build and load all Docker images (ENV=local VERSION=latest)
	$(call print_message,Building Docker images with version: $(VERSION))
	@echo ""
	@echo "$(COLOR_BOLD)Building go-auth...$(COLOR_RESET)"
	@docker build -t $(REGISTRY_HOST)/go-auth:$(VERSION) ../ttrpg-api/go_auth
	@k3d image import $(REGISTRY_HOST)/go-auth:$(VERSION) -c $(CLUSTER_NAME)
	$(call print_success,go-auth image built and loaded)
	@echo ""
	@echo "$(COLOR_BOLD)Building go-sprint...$(COLOR_RESET)"
	@docker build -f ../ttrpg-api/go_sprint/Dockerfile -t $(REGISTRY_HOST)/go-sprint:$(VERSION) ../ttrpg-api
	@k3d image import $(REGISTRY_HOST)/go-sprint:$(VERSION) -c $(CLUSTER_NAME)
	$(call print_success,go-sprint image built and loaded)
	@echo ""
	@echo "$(COLOR_BOLD)Building py-dnd...$(COLOR_RESET)"
	@docker build --target development -f ../ttrpg-api/py_dnd/deploy/Dockerfile -t $(REGISTRY_HOST)/py-dnd:$(VERSION) ../ttrpg-api/py_dnd
	@k3d image import $(REGISTRY_HOST)/py-dnd:$(VERSION) -c $(CLUSTER_NAME)
	$(call print_success,py-dnd image built and loaded)
	@echo ""
	@echo "$(COLOR_BOLD)Building ui-dnd...$(COLOR_RESET)"
	@docker build -f ../ttrpg-ui/apps/dnd/deploy/Dockerfile -t $(REGISTRY_HOST)/ui-dnd:$(VERSION) --build-arg APP_NAME=dnd --build-arg BUILD_BASE_HREF=/ttrpg/dnd/ ../ttrpg-ui
	@k3d image import $(REGISTRY_HOST)/ui-dnd:$(VERSION) -c $(CLUSTER_NAME)
	$(call print_success,ui-dnd image built and loaded)
	@echo ""
	@echo "$(COLOR_BOLD)Building ui-sprint-management...$(COLOR_RESET)"
	@docker build -f ../ttrpg-ui/apps/sprint-management/deploy/Dockerfile -t $(REGISTRY_HOST)/ui-sprint-management:$(VERSION) --build-arg APP_NAME=sprint-management ../ttrpg-ui
	@k3d image import $(REGISTRY_HOST)/ui-sprint-management:$(VERSION) -c $(CLUSTER_NAME)
	$(call print_success,ui-sprint-management image built and loaded)
	@echo ""
	$(call print_success,All images built and loaded)

deploy-infra: check-prereqs ## Deploy infrastructure components (Vault, PostgreSQL, Keycloak, NATS, Ingress) with wait conditions
	$(call print_message,Deploying infrastructure components to $(NAMESPACE))
	@echo ""
	@echo "$(COLOR_BOLD)Installing cert-manager CRDs...$(COLOR_RESET)"
	@kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.13.0/cert-manager.crds.yaml || $(call print_warning,CRDs may already be installed)
	@echo ""
	@echo "$(COLOR_BOLD)Deploying with Helm...$(COLOR_RESET)"
	@helm upgrade --install $(RELEASE_NAME) $(CHART_PATH) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values $(CHART_PATH)/values-$(ENV).yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(ENV) \
		--set vault.enabled=true \
		--set go-auth.enabled=false \
		--set go-sprint.enabled=false \
		--set py-dnd.enabled=false \
		--set ui-dnd.enabled=false \
		--set ui-sprint-management.enabled=false \
		--wait \
		--timeout 10m
	@echo ""
	$(call print_message,Waiting for Vault to be ready...)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=vault -n $(NAMESPACE) --timeout=300s || \
		($(call print_error,Vault failed to become ready); exit 1)
	$(call print_success,Vault is ready)
	@echo ""
	$(call print_message,Waiting for PostgreSQL to be ready...)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=postgresql -n $(NAMESPACE) --timeout=300s || \
		($(call print_error,PostgreSQL failed to become ready); exit 1)
	$(call print_success,PostgreSQL is ready)
	@echo ""
	$(call print_message,Waiting for Keycloak to be ready...)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=keycloak -n $(NAMESPACE) --timeout=300s || \
		($(call print_error,Keycloak failed to become ready); exit 1)
	$(call print_success,Keycloak is ready)
	@echo ""
	$(call print_success,Infrastructure deployment completed)

init-vault: check-prereqs ## Initialize and unseal Vault, store root token
	$(call print_message,Initializing Vault...)
	@./scripts/init-vault.sh $(ENV)
	$(call print_success,Vault initialized)
	@echo ""
	$(call print_message,Unsealing Vault...)
	@./scripts/unseal-vault.sh $(ENV)
	$(call print_success,Vault unsealed)

configure-vault: check-prereqs ## Apply vault-config-job and wait for completion
	$(call print_message,Configuring Vault database secrets engine...)
	@./scripts/vault-configure.sh $(ENV)
	$(call print_success,Vault configured)

deploy-apps: check-prereqs ## Deploy application services with migrations enabled
	$(call print_message,Deploying application services to $(NAMESPACE))
	@echo ""
	@echo "$(COLOR_BOLD)Enabling all applications...$(COLOR_RESET)"
	@helm upgrade --install $(RELEASE_NAME) $(CHART_PATH) \
		--namespace $(NAMESPACE) \
		--values $(CHART_PATH)/values-$(ENV).yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(ENV) \
		--set vault.enabled=true \
		--set go-auth.enabled=true \
		--set go-sprint.enabled=true \
		--set py-dnd.enabled=true \
		--set ui-dnd.enabled=true \
		--set ui-sprint-management.enabled=true \
		--set go-auth.migration.enabled=true \
		--set go-sprint.migration.enabled=true \
 		--set py-dnd.migration.enabled=true \
		--wait \
		--timeout 10m
	@echo ""
	$(call print_message,Waiting for application pods to be ready...)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=go-auth -n $(NAMESPACE) --timeout=300s || \
		($(call print_warning,go-auth not ready); true)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=go-sprint -n $(NAMESPACE) --timeout=300s || \
		($(call print_warning,go-sprint not ready); true)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=py-dnd -n $(NAMESPACE) --timeout=300s || \
		($(call print_warning,py-dnd not ready); true)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=ui-dnd -n $(NAMESPACE) --timeout=300s || \
		($(call print_warning,ui-dnd not ready); true)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=ui-sprint-management -n $(NAMESPACE) --timeout=300s || \
		($(call print_warning,ui-sprint-management not ready); true)
	@echo ""
	$(call print_success,Application deployment completed)

deploy-all-in-one: check-prereqs ## Deploy infrastructure AND applications in single Helm install (ENV=local VERSION=latest)
	$(call print_message,Deploying all components to $(NAMESPACE))
	@echo ""
	@echo "$(COLOR_BOLD)Installing cert-manager CRDs...$(COLOR_RESET)"
	@kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.13.0/cert-manager.crds.yaml || $(call print_warning,CRDs may already be installed)
	@echo ""
	@echo "$(COLOR_BOLD)Cleaning up any existing Helm release...$(COLOR_RESET)"
	@helm uninstall $(RELEASE_NAME) -n $(NAMESPACE) 2>/dev/null || $(call print_warning,No existing release to clean up)
	@kubectl delete namespace $(NAMESPACE) --wait=true 2>/dev/null || $(call print_warning,Namespace does not exist)
	@kubectl delete namespace vault --wait=true 2>/dev/null || $(call print_warning,Vault namespace does not exist)
	@sleep 3
	@echo ""
	@echo "$(COLOR_BOLD)Deploying with Helm (infrastructure + applications)...$(COLOR_RESET)"
	@helm install $(RELEASE_NAME) $(CHART_PATH) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values $(CHART_PATH)/values-$(ENV).yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(ENV) \
		--set go-auth.enabled=true \
		--set go-sprint.enabled=true \
		--set py-dnd.enabled=true \
		--set ui-dnd.enabled=true \
		--set ui-sprint-management.enabled=true \
		--set go-auth.migration.enabled=false \
		--set go-sprint.migration.enabled=false \
		--set py-dnd.migration.enabled=false \
		--wait \
		--timeout 10m
	@echo ""
	$(call print_message,Waiting for infrastructure to be ready...)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=postgresql -n $(NAMESPACE) --timeout=300s || \
		($(call print_error,PostgreSQL failed to become ready); exit 1)
	$(call print_success,PostgreSQL is ready)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=vault -n vault --timeout=300s || \
		($(call print_error,Vault failed to become ready); exit 1)
	$(call print_success,Vault is ready)
	@kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=keycloak -n $(NAMESPACE) --timeout=300s || \
		($(call print_error,Keycloak failed to become ready); exit 1)
	$(call print_success,Keycloak is ready)
	@echo ""
	$(call print_success,All components deployed)

deploy-clean: check-prereqs ## Complete clean deployment from scratch (ENV=local VERSION=latest)
	@echo ""
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)  Clean Deployment Automation$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)Environment:$(COLOR_RESET) $(ENV)"
	@echo "$(COLOR_BOLD)Version:$(COLOR_RESET)     $(VERSION)"
	@echo "$(COLOR_BOLD)Namespace:$(COLOR_RESET)   $(NAMESPACE)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo ""
	@echo "$(COLOR_BOLD)Step 1/6: Teardown$(COLOR_RESET)"
	@$(MAKE) teardown ENV=$(ENV)
	@echo ""
	@echo "$(COLOR_BOLD)Step 2/6: Build Images$(COLOR_RESET)"
	@$(MAKE) build-images ENV=$(ENV) VERSION=$(VERSION)
	@echo ""
	@echo "$(COLOR_BOLD)Step 3/6: Deploy Infrastructure$(COLOR_RESET)"
	@$(MAKE) deploy-infra ENV=$(ENV) VERSION=$(VERSION)
	@echo ""
	@echo "$(COLOR_BOLD)Step 4/6: Initialize Vault$(COLOR_RESET)"
	@$(MAKE) init-vault ENV=$(ENV)
	@echo ""
	@echo "$(COLOR_BOLD)Step 5/6: Configure Vault$(COLOR_RESET)"
	@$(MAKE) configure-vault ENV=$(ENV)
	@echo ""
	@echo "$(COLOR_BOLD)Step 6/6: Deploy Applications$(COLOR_RESET)"
	@$(MAKE) deploy-apps ENV=$(ENV) VERSION=$(VERSION)
	@echo ""
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)  Clean Deployment Completed!$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo ""
	@echo "$(COLOR_BOLD)Access your services:$(COLOR_RESET)"
	@echo "  • Ingress:  http://localhost:8080/ttrpg/"
	@echo "  • Vault:    http://localhost:8200"
	@echo "  • Keycloak: http://localhost:8180"
	@echo ""

##@ Vault Operations

vault-init: check-prereqs ## Initialize Vault (ENV=local|dev|prod)
	$(call print_message,Initializing Vault for environment: $(ENV))
	@./scripts/init-vault.sh $(ENV)
	$(call print_success,Vault initialized)

vault-unseal: check-prereqs ## Unseal Vault (ENV=local|dev|prod)
	$(call print_message,Unsealing Vault for environment: $(ENV))
	@./scripts/unseal-vault.sh $(ENV)
	$(call print_success,Vault unsealed)

vault-configure: check-prereqs ## Configure Vault secrets engines and policies (ENV=local|dev|prod)
	$(call print_message,Configuring Vault for environment: $(ENV))
	@./scripts/vault-configure.sh $(ENV)
	$(call print_success,Vault configured)

vault-rotate-db: check-prereqs ## Rotate database credentials for specific app (ENV=prod APP=go-auth)
	$(call print_message,Rotating database credentials for $(APP) in $(ENV))
	@if [ -z "$(APP)" ]; then \
		$(call print_error,APP parameter is required. Usage: make vault-rotate-db ENV=prod APP=go-auth); \
		exit 1; \
	fi
	@kubectl exec -n vault vault-0 -- vault lease revoke -prefix $(ENV)/database/creds/$(APP)-role
	$(call print_success,Database credentials rotated for $(APP))

vault-backup: check-prereqs ## Backup Vault data (ENV=prod)
	$(call print_message,Backing up Vault for environment: $(ENV))
	@./scripts/backup-vault.sh $(ENV)
	$(call print_success,Vault backup completed)

vault-restore: check-prereqs ## Restore Vault from backup (ENV=prod BACKUP=file.tar.gz)
	$(call print_message,Restoring Vault for environment: $(ENV))
	@if [ -z "$(BACKUP)" ]; then \
		$(call print_error,BACKUP parameter is required. Usage: make vault-restore ENV=prod BACKUP=file.tar.gz); \
		exit 1; \
	fi
	@./scripts/restore-vault.sh $(ENV) $(BACKUP)
	$(call print_success,Vault restored from backup)

##@ Deployment

deploy-local: check-prereqs ## Deploy to local environment
	$(call print_message,Deploying to local environment...)
	@$(MAKE) deploy ENV=local VERSION=$(VERSION)

deploy-dev: check-prereqs ## Deploy to dev environment
	$(call print_message,Deploying to dev environment...)
	@$(MAKE) deploy ENV=dev VERSION=$(VERSION)

deploy-prod: check-prereqs ## Deploy to prod environment
	$(call print_message,Deploying to prod environment...)
	@$(MAKE) deploy ENV=prod VERSION=$(VERSION)

deploy: check-prereqs ## Deploy to specified environment (ENV=local|dev|prod VERSION=v1.2.3)
	$(call print_message,Deploying $(RELEASE_NAME) to $(NAMESPACE) with version $(VERSION))
	@if [ ! -f "$(CHART_PATH)/values-$(ENV).yaml" ]; then \
		$(call print_error,Values file not found: $(CHART_PATH)/values-$(ENV).yaml); \
		exit 1; \
	fi
	@helm upgrade --install $(RELEASE_NAME) $(CHART_PATH) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values $(CHART_PATH)/values-$(ENV).yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(ENV) \
		--wait \
		--timeout 10m
	$(call print_success,Deployment completed successfully)

deploy-app: check-prereqs ## Deploy single application (APP=go-auth ENV=dev VERSION=v1.2.3)
	$(call print_message,Deploying application: $(APP) to $(ENV))
	@if [ -z "$(APP)" ]; then \
		$(call print_error,APP parameter is required. Usage: make deploy-app APP=go-auth ENV=dev VERSION=v1.2.3); \
		exit 1; \
	fi
	@helm upgrade --install $(RELEASE_NAME) $(CHART_PATH) \
		--namespace $(NAMESPACE) \
		--create-namespace \
		--values $(CHART_PATH)/values-$(ENV).yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(ENV) \
		--set $(APP).version=$(VERSION) \
		--set $(APP).enabled=true \
		--wait \
		--timeout 10m
	$(call print_success,Application $(APP) deployed successfully)

deploy-ephemeral: check-prereqs ## Deploy ephemeral environment with random name
	$(eval EPHEMERAL_NAME := test-$(shell date +%s)-$(shell echo $$RANDOM))
	$(eval EPHEMERAL_NAMESPACE := ttrpg-$(EPHEMERAL_NAME))
	$(call print_message,Deploying ephemeral environment: $(EPHEMERAL_NAME))
	@helm upgrade --install ttrpg-$(EPHEMERAL_NAME) $(CHART_PATH) \
		--namespace $(EPHEMERAL_NAMESPACE) \
		--create-namespace \
		--values $(CHART_PATH)/values-local.yaml \
		--set global.version=$(VERSION) \
		--set global.environment=$(EPHEMERAL_NAME) \
		--wait \
		--timeout 10m
	$(call print_success,Ephemeral environment deployed: $(EPHEMERAL_NAME))
	@echo ""
	@echo "$(COLOR_BOLD)To destroy this environment, run:$(COLOR_RESET)"
	@echo "  make destroy ENV=$(EPHEMERAL_NAME)"

##@ Verification

verify: check-prereqs ## Verify deployment health (ENV=local|dev|prod)
	$(call print_message,Verifying deployment in $(NAMESPACE)...)
	@./scripts/verify-deployment.sh $(ENV)

verify-migrations: check-prereqs ## Verify migration jobs completed successfully (ENV=local|dev|prod)
	$(call print_message,Verifying migration jobs in $(NAMESPACE)...)
	@echo ""
	@echo "$(COLOR_BOLD)Checking migration job status...$(COLOR_RESET)"
	@kubectl get jobs -n $(NAMESPACE) | grep migration || $(call print_warning,No migration jobs found)
	@echo ""
	@echo "$(COLOR_BOLD)go-auth migration:$(COLOR_RESET)"
	@kubectl get job -n $(NAMESPACE) -l app.kubernetes.io/name=go-auth,app.kubernetes.io/component=migration -o jsonpath='{.items[0].status.succeeded}' 2>/dev/null | grep -q "1" && $(call print_success,Completed successfully) || $(call print_warning,Not completed or failed)
	@echo ""
	@echo "$(COLOR_BOLD)go-sprint migration:$(COLOR_RESET)"
	@kubectl get job -n $(NAMESPACE) -l app.kubernetes.io/name=go-sprint,app.kubernetes.io/component=migration -o jsonpath='{.items[0].status.succeeded}' 2>/dev/null | grep -q "1" && $(call print_success,Completed successfully) || $(call print_warning,Not completed or failed)
	@echo ""
	@echo "$(COLOR_BOLD)py-dnd migration:$(COLOR_RESET)"
	@kubectl get job -n $(NAMESPACE) -l app.kubernetes.io/name=py-dnd,app.kubernetes.io/component=migration -o jsonpath='{.items[0].status.succeeded}' 2>/dev/null | grep -q "1" && $(call print_success,Completed successfully) || $(call print_warning,Not completed or failed)
	@echo ""
	$(call print_success,Migration verification completed)

test-vault-properties: check-prereqs ## Run property-based tests for Vault configuration (ENV=local|dev|prod)
	$(call print_message,Running Vault property tests for $(ENV)...)
	@./tests/test_vault_config.sh $(ENV)
	$(call print_success,Property tests completed)

test-deployment-properties: check-prereqs ## Run property-based tests for deployment automation (ENV=local|dev|prod)
	$(call print_message,Running deployment automation property tests for $(ENV)...)
	@./tests/test_deployment_automation.sh $(ENV)
	$(call print_success,Property tests completed)

test-migration-properties: check-prereqs ## Run property-based tests for migration jobs (ENV=local|dev|prod)
	$(call print_message,Running migration property tests for $(ENV)...)
	@./tests/test_migration_jobs.sh $(ENV)
	$(call print_success,Property tests completed)

test-verification-properties: check-prereqs ## Run property-based tests for deployment verification (ENV=local|dev|prod)
	$(call print_message,Running verification property tests for $(ENV)...)
	@./tests/test_verification.sh $(ENV)
	$(call print_success,Property tests completed)

migration-status: check-prereqs ## Show detailed migration status (ENV=local|dev|prod APP=go-auth)
	$(call print_message,Showing migration status for $(NAMESPACE)...)
	@if [ -z "$(APP)" ]; then \
		echo "$(COLOR_BOLD)All migration jobs:$(COLOR_RESET)"; \
		kubectl get jobs -n $(NAMESPACE) -l app.kubernetes.io/component=migration -o wide; \
	else \
		echo "$(COLOR_BOLD)Migration job for $(APP):$(COLOR_RESET)"; \
		kubectl get job -n $(NAMESPACE) -l app.kubernetes.io/name=$(APP),app.kubernetes.io/component=migration -o wide; \
	fi

migration-logs: check-prereqs ## Show migration job logs (ENV=local|dev|prod APP=go-auth)
	$(call print_message,Showing migration logs for $(NAMESPACE)...)
	@if [ -z "$(APP)" ]; then \
		$(call print_error,APP parameter is required. Usage: make migration-logs ENV=local APP=go-auth); \
		exit 1; \
	fi
	@echo "$(COLOR_BOLD)Logs for $(APP) migration:$(COLOR_RESET)"
	@kubectl logs -n $(NAMESPACE) -l app.kubernetes.io/name=$(APP),app.kubernetes.io/component=migration --tail=100

migration-retry: check-prereqs ## Retry failed migration by deleting job and redeploying (ENV=local|dev|prod APP=go-auth)
	$(call print_message,Retrying migration for $(APP) in $(NAMESPACE)...)
	@if [ -z "$(APP)" ]; then \
		$(call print_error,APP parameter is required. Usage: make migration-retry ENV=local APP=go-auth); \
		exit 1; \
	fi
	@echo "$(COLOR_BOLD)Deleting existing migration job...$(COLOR_RESET)"
	@kubectl delete job -n $(NAMESPACE) -l app.kubernetes.io/name=$(APP),app.kubernetes.io/component=migration || $(call print_warning,No job found to delete)
	@echo ""
	@echo "$(COLOR_BOLD)Redeploying to trigger migration...$(COLOR_RESET)"
	@$(MAKE) deploy-app APP=$(APP) ENV=$(ENV) VERSION=$(VERSION)
	$(call print_success,Migration retry completed)

##@ Skaffold Integration

skaffold-dev: check-prereqs ## Run Skaffold in dev mode with port forwarding
	$(call print_message,Starting Skaffold in dev mode...)
	@skaffold dev --port-forward

skaffold-debug: check-prereqs ## Run Skaffold in debug mode with port forwarding
	$(call print_message,Starting Skaffold in debug mode...)
	@skaffold debug --port-forward -p debug

skaffold-app: check-prereqs ## Run Skaffold for single app (APP=go-auth)
	$(call print_message,Starting Skaffold for application: $(APP))
	@if [ -z "$(APP)" ]; then \
		$(call print_error,APP parameter is required. Usage: make skaffold-app APP=go-auth); \
		exit 1; \
	fi
	@skaffold dev --port-forward -p $(APP)-only

skaffold-delete: check-prereqs ## Delete Skaffold deployment
	$(call print_message,Deleting Skaffold deployment...)
	@skaffold delete
	$(call print_success,Skaffold deployment deleted)

##@ Chart Management

update-charts: ## Update Helm chart dependencies (rebuild .tgz packages)
	$(call print_message,Updating Helm chart dependencies...)
	@cd $(CHART_PATH) && helm dependency update
	$(call print_success,Chart dependencies updated)

clean-charts: ## Remove packaged chart dependencies (.tgz files) for development
	$(call print_message,Removing packaged chart dependencies...)
	@rm -f $(CHART_PATH)/charts/*.tgz
	$(call print_success,Packaged charts removed - using source directories)

##@ Cleanup

destroy: check-prereqs ## Destroy environment (ENV=test-abc123)
	$(call print_message,Destroying environment: $(ENV))
	@helm uninstall ttrpg-$(ENV) -n ttrpg-$(ENV) || $(call print_warning,Release not found)
	@kubectl delete namespace ttrpg-$(ENV) || $(call print_warning,Namespace not found)
	$(call print_success,Environment destroyed)

clean: ## Remove generated files and temporary data
	$(call print_message,Cleaning up generated files...)
	@find . -name "*.tmp" -delete
	@find . -name "*.log" -delete
	@rm -rf .helm-cache
	$(call print_success,Cleanup completed)

##@ Quick Start

quickstart: create-cluster deploy-local vault-init vault-unseal vault-configure verify ## Quick start: create cluster and deploy everything
	@echo ""
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)  Quick Start Completed Successfully!$(COLOR_RESET)"
	@echo "$(COLOR_BOLD)$(COLOR_GREEN)========================================$(COLOR_RESET)"
	@echo ""
	@echo "$(COLOR_BOLD)Access your services:$(COLOR_RESET)"
	@echo "  • Ingress:  http://localhost:8080/ttrpg/"
	@echo "  • Vault:    http://localhost:8200"
	@echo "  • Keycloak: http://localhost:8180"
	@echo ""
	@echo "$(COLOR_BOLD)Next steps:$(COLOR_RESET)"
	@echo "  • Run 'make skaffold-dev' for live development"
	@echo "  • Run 'make verify ENV=local' to check deployment health"
	@echo "  • Run 'make help' to see all available commands"
	@echo ""
